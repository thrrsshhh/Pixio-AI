generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  credits   Int      @default(10)
  createdAt DateTime @default(now())
  images    Image[]
}

model Image {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  originalUrl  String
  processedUrl String?
  type         String
  createdAt    DateTime @default(now())
}